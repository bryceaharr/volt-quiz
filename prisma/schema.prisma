generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Mirrors auth.users; created on first sign-in.
model Profile {
  id          String   @id @db.Uuid
  email       String   @unique
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  quizzes     Quiz[]

  @@map("profiles")
}

enum QuizStatus {
  draft
  published
}

model Quiz {
  id          String     @id @default(cuid())
  ownerId     String     @map("owner_id") @db.Uuid
  title       String
  description String?
  coverEmoji  String?    @default("⚡") @map("cover_emoji")
  status      QuizStatus @default(draft)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner     Profile       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  questions Question[]
  sessions  GameSession[]

  @@index([ownerId, updatedAt])
  @@map("quizzes")
}

enum QuestionType {
  multiple_choice
  true_false
  poll
}

model Question {
  id          String       @id @default(cuid())
  quizId      String       @map("quiz_id")
  type        QuestionType @default(multiple_choice)
  prompt      String
  imageUrl    String?      @map("image_url")
  timeLimit   Int          @default(20) @map("time_limit")
  points      Int          @default(1000)
  explanation String?
  order       Int

  quiz      Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   AnswerOption[]
  responses Response[]

  @@index([quizId, order])
  @@map("questions")
}

model AnswerOption {
  id         String  @id @default(cuid())
  questionId String  @map("question_id")
  text       String
  isCorrect  Boolean @default(false) @map("is_correct")
  order      Int

  question  Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses Response[]

  @@index([questionId, order])
  @@map("answer_options")
}

enum SessionState {
  lobby
  question_active
  question_locked
  showing_results
  showing_leaderboard
  completed
}

model GameSession {
  id                String       @id @default(cuid())
  code              String       @unique // 6-char join code
  quizId            String       @map("quiz_id")
  hostId            String       @map("host_id") @db.Uuid
  state             SessionState @default(lobby)
  currentQuestionId String?      @map("current_question_id")
  questionStartedAt DateTime?    @map("question_started_at")
  startedAt         DateTime?    @map("started_at")
  endedAt           DateTime?    @map("ended_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  quiz      Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  players   Player[]
  responses Response[]

  @@index([code])
  @@map("game_sessions")
}

model Player {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  displayName String   @map("display_name")
  avatarSeed  String   @default("default") @map("avatar_seed")
  joinedAt    DateTime @default(now()) @map("joined_at")
  isConnected Boolean  @default(true) @map("is_connected")

  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  responses Response[]

  @@unique([sessionId, displayName])
  @@index([sessionId])
  @@map("players")
}

model Response {
  id               String  @id @default(cuid())
  sessionId        String  @map("session_id")
  questionId       String  @map("question_id")
  playerId         String  @map("player_id")
  selectedOptionId String? @map("selected_option_id")
  textAnswer       String? @map("text_answer")
  msToAnswer       Int     @map("ms_to_answer")
  isCorrect        Boolean @default(false) @map("is_correct")
  pointsAwarded    Int     @default(0) @map("points_awarded")
  createdAt        DateTime @default(now()) @map("created_at")

  session  GameSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  player   Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  option   AnswerOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([sessionId, questionId, playerId])
  @@index([sessionId, questionId])
  @@map("responses")
}
